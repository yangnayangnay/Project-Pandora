<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.mine.ProfileActivity">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_bg_page">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_surface"
            app:title="个人信息"
            app:titleTextColor="@color/color_text_primary"
            app:navigationIcon="@drawable/ic_back"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.Pandora.Toolbar"
            app:navigationIconTint="@color/color_text_primary"
            android:elevation="0dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/color_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="账号信息"
                            android:textColor="@color/color_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/imageAvatar"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="修改头像" />

                        <ProgressBar
                            android:id="@+id/progressAvatarUpload"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/textAvatarHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="4dp"
                            android:text="@string/avatar_upload_hint"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp" />

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="20dp" android:text="工号" android:labelFor="@id/textUsername"
                            android:textSize="13sp" android:textColor="@color/color_text_secondary" />
                        <TextView android:id="@+id/textUsername" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textSize="16sp" android:textColor="@color/color_text_primary"
                            tools:text="000123" />

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="16dp" android:text="真实姓名" android:labelFor="@id/textRealName"
                            android:textSize="13sp" android:textColor="@color/color_text_secondary" />
                        <TextView android:id="@+id/textRealName" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textSize="16sp" android:textColor="@color/color_text_primary"
                            tools:text="张三" />

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="16dp" android:text="邮箱" android:labelFor="@id/textEmail"
                            android:textSize="13sp" android:textColor="@color/color_text_secondary" />
                        <TextView android:id="@+id/textEmail" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textSize="16sp" android:textColor="@color/color_text_primary"
                            tools:text="zhangsan@example.com" />

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="16dp" android:text="手机号" android:labelFor="@id/textPhone"
                            android:textSize="13sp" android:textColor="@color/color_text_secondary" />
                        <TextView android:id="@+id/textPhone" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textSize="16sp" android:textColor="@color/color_text_primary"
                            tools:text="13800138000" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/color_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="账号维护"
                            android:textColor="@color/color_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:id="@+id/textAccountMaintenance"
                            android:text="真实姓名、邮箱、工号、手机号及密码由管理员统一维护，如需变更请联系管理员。"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/signatureLayout"
                            style="@style/Widget.Pandora.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="个人签名"
                            app:helperText="最多 20 字、4 行（含自动换行）"
                            app:counterEnabled="true"
                            app:counterMaxLength="20">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editSignature"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="start|top"
                                android:inputType="textMultiLine|textCapSentences"
                                android:maxLength="20"
                                android:maxLines="4"
                                android:scrollHorizontally="false"
                                android:scrollbars="none"
                                android:minLines="2" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/textSignatureStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="13sp" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSaveSignature"
                                style="@style/Widget.Pandora.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="保存签名" />
                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/color_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="组织信息"
                            android:textColor="@color/color_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="角色"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textRole"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/color_text_primary"
                            android:textSize="16sp"
                            tools:text="员工" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:id="@+id/labelDepartment"
                            android:text="部门"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textDepartment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/color_text_primary"
                            android:textSize="16sp"
                            tools:text="产品研发部" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:id="@+id/labelTeam"
                            android:text="团队"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textTeam"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/color_text_primary"
                            android:textSize="16sp"
                            tools:text="移动端组" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
