<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/login_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/text_server_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/server_checking"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:textColor="#FF9800" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_refresh_server"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_refresh_server"
        android:textSize="13sp"
        android:visibility="gone"
        android:layout_marginBottom="8dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <!-- Round29 T7 修复: 生效地址不可达时的自救入口（冷启动登录页可达，避免恢复路径断裂） -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_login_server_config"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_login_server_config"
        android:textSize="13sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MaterialComponents.Button.TextButton" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_username_or_email"
            android:inputType="text"
            android:textColor="@color/color_text_edit_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:textColor="@color/color_text_edit_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_login"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton

        android:id="@+id/btn_forgot_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_forgot_password"
        android:textSize="14sp"
        style="@style/Widget.MaterialComponents.Button.TextButton" />

</LinearLayout>
