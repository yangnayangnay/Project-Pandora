<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data />
    <com.example.project_pandora.ui.home.HomeBackdropLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@android:color/transparent" app:title="@string/nav_mindmap" app:titleTextColor="@color/color_text_primary" />
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/homeCoordinator" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:clipChildren="true" android:clipToPadding="true">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/homeAppBar" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@android:color/transparent" android:clipChildren="false" android:clipToPadding="false"
                app:elevation="0dp" app:statusBarForeground="@null">
                <LinearLayout android:id="@+id/boardPanels"
                    android:layout_width="match_parent" android:layout_height="160dp" android:orientation="horizontal"
                    android:paddingHorizontal="12dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:clipToPadding="false" android:clipChildren="false" app:layout_scrollFlags="scroll|snap">
                    <com.example.project_pandora.ui.home.HomeGlassPanel android:id="@+id/quadrant_top_left"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:layout_marginEnd="6dp" android:orientation="vertical" app:homeGlassTone="events">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="top" android:paddingStart="12dp" android:paddingEnd="0dp" android:paddingTop="8dp">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="vertical">
                                <TextView android:id="@+id/textEventsTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:gravity="center_vertical" android:includeFontPadding="false"
                                    android:text="事件纪" android:textSize="@dimen/home_section_title_size" android:textStyle="bold" android:textColor="@color/home_event_text" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false"
                                    android:text="公司重要事项" android:textSize="13sp" android:textColor="@color/home_event_secondary" />
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnExpandEvents" style="@style/Widget.Pandora.Button.Text"
                                    android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                                    android:contentDescription="展开事件纪，查看完整内容" app:icon="@drawable/ic_open_fullscreen"
                                    app:iconSize="24dp" app:iconPadding="0dp" app:iconTint="@color/home_event_text" app:rippleColor="@color/home_event_press" />
                        </LinearLayout>
                        <androidx.core.widget.NestedScrollView android:id="@+id/scroll_company_important"
                            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
                            <LinearLayout android:id="@+id/list_company_important"
                                android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingTop="4dp" android:paddingBottom="8dp" />
                        </androidx.core.widget.NestedScrollView>
                    </com.example.project_pandora.ui.home.HomeGlassPanel>
                    <com.example.project_pandora.ui.home.HomeGlassPanel android:id="@+id/quadrant_top_right"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:layout_marginStart="6dp" android:orientation="vertical" app:homeGlassTone="tasks">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="top" android:paddingStart="12dp" android:paddingEnd="0dp" android:paddingTop="8dp">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="vertical">
                                <TextView android:id="@+id/textTasksTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:gravity="center_vertical" android:includeFontPadding="false"
                                    android:text="任务看板" android:textSize="@dimen/home_section_title_size" android:textStyle="bold" android:textColor="@color/home_task_text" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false"
                                    android:text="我的未完成任务" android:textSize="13sp" android:textColor="@color/home_task_secondary" />
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnExpandTasks" style="@style/Widget.Pandora.Button.Text"
                                    android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                                    android:contentDescription="展开任务看板，查看完整内容" app:icon="@drawable/ic_open_fullscreen"
                                    app:iconSize="24dp" app:iconPadding="0dp" app:iconTint="@color/home_task_text" app:rippleColor="@color/home_task_press" />
                        </LinearLayout>
                        <androidx.core.widget.NestedScrollView android:id="@+id/scroll_company_dispatch"
                            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
                            <LinearLayout android:id="@+id/list_company_dispatch"
                                android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingTop="4dp" android:paddingBottom="8dp" />
                        </androidx.core.widget.NestedScrollView>
                    </com.example.project_pandora.ui.home.HomeGlassPanel>
                </LinearLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <androidx.core.widget.NestedScrollView android:id="@+id/scrollDailyAgenda"
                android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
                android:clipToPadding="false" app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingBottom="88dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="每日事项" android:textSize="@dimen/home_section_title_size" android:textStyle="bold" android:textColor="@color/color_text_primary" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnExpandAgenda" style="@style/Widget.Pandora.Button.Text"
                            android:layout_width="wrap_content" android:layout_height="48dp" android:text="展开日历" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnPreviousDailyMonth" style="@style/Widget.Pandora.Button.Text"
                            android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="0dp"
                            android:text="‹" android:textSize="24sp" android:contentDescription="上个月" />
                        <TextView android:id="@+id/textDailyMonth" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                            android:gravity="center_vertical" android:textSize="@dimen/calendar_date_text_size" android:textStyle="bold" android:textColor="@color/color_text_primary"
                            android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:contentDescription="选择每日事项日期" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnNextDailyMonth" style="@style/Widget.Pandora.Button.Text"
                            android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="0dp"
                            android:text="›" android:textSize="24sp" android:contentDescription="下个月" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnDailyToday" style="@style/Widget.Pandora.Button.Text"
                            android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:text="今天" />
                    </LinearLayout>
                    <com.example.project_pandora.ui.home.DailyItemsMonthView android:id="@+id/dailyCalendar"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:id="@+id/textDailyHeading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:textSize="16sp" android:textStyle="bold" android:textColor="@color/color_text_primary" />
                    </LinearLayout>
                    <ProgressBar android:id="@+id/dailyProgress" style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:visibility="gone" />
                    <TextView android:id="@+id/textDailyMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                        android:gravity="center" android:padding="16dp" android:textColor="@color/home_photo_secondary" android:textSize="14sp" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerDailyItems"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnAddDailyItem"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|end" android:layout_margin="16dp"
                android:contentDescription="新增事项" android:src="@android:drawable/ic_input_add"
                app:backgroundTint="@color/color_accent" app:tint="@color/color_on_accent"
                app:behavior_autoHide="false" />
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </com.example.project_pandora.ui.home.HomeBackdropLayout>
</layout>
