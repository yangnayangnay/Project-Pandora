<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_bg_page">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_schedule_tabs"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="8dp"
                android:contentDescription="@string/a11y_tab_view_mode"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabIndicator="@drawable/bg_schedule_tab_selected"
                app:tabIndicatorHeight="40dp"
                app:tabIndicatorGravity="center"
                app:tabIndicatorFullWidth="false"
                app:tabSelectedTextColor="@color/color_text_primary" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.example.project_pandora.ui.widget.MonthCalendarLayout
                    android:id="@+id/containerMonthView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="@color/color_month_page">

                    <FrameLayout
                        android:id="@+id/monthHeader"
                        android:layout_width="match_parent"
                        android:layout_height="440dp"
                        android:background="@color/color_month_page">

                        <LinearLayout
                            android:id="@+id/expandedMonthHeader"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/layoutMonthNav"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnPreviousMonth"
                                    style="@style/Widget.Pandora.Button.Text"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:paddingHorizontal="0dp"
                                    android:text="‹"
                                    android:textSize="24sp"
                                    android:contentDescription="上个月" />

                                <TextView
                                    android:id="@+id/textMonthLabel"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="start|center_vertical"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/color_text_primary"
                                    tools:text="2026年10月" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNextMonth"
                                    style="@style/Widget.Pandora.Button.Text"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:paddingHorizontal="0dp"
                                    android:text="›"
                                    android:textSize="24sp"
                                    android:contentDescription="下个月" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnResetZoom"
                                    style="@style/Widget.Pandora.Button.Text"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:paddingHorizontal="0dp"
                                    android:text="今天"
                                    android:textSize="14sp"
                                    android:contentDescription="回到今天" />

                            </LinearLayout>

                            <com.example.project_pandora.ui.widget.PhoneMonthView
                                android:id="@+id/calendarView"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="12dp" />

                            <TextView
                                android:id="@+id/monthDragHandle"
                                android:layout_width="match_parent"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:text="━"
                                android:textSize="14sp"
                                android:textColor="@color/color_text_secondary"
                                android:contentDescription="上滑查看全部任务，下滑展开每日任务" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/compactMonthHeader"
                            android:layout_width="match_parent"
                            android:layout_height="144dp"
                            android:layout_gravity="top"
                            android:orientation="vertical"
                            android:background="@color/color_month_page"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp">

                                <TextView
                                    android:id="@+id/compactMonthLabel"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/color_text_primary"
                                    tools:text="2026年10月" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCompactPreviousMonth"
                                    style="@style/Widget.Pandora.Button.Text"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:paddingHorizontal="0dp"
                                    android:text="‹"
                                    android:textSize="24sp"
                                    android:contentDescription="上个月" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCompactNextMonth"
                                    style="@style/Widget.Pandora.Button.Text"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:paddingHorizontal="0dp"
                                    android:text="›"
                                    android:textSize="24sp"
                                    android:contentDescription="下个月" />

                            </LinearLayout>

                            <com.example.project_pandora.ui.widget.WeekDateStrip
                                android:id="@+id/monthWeekStrip"
                                android:layout_width="match_parent"
                                android:layout_height="88dp" />

                        </LinearLayout>

                    </FrameLayout>

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/scrollPanelTaskTable"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingBottom="88dp">

                            <TextView
                                android:id="@+id/monthTaskHeading"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="12dp"
                                android:text="当天任务"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_text_primary" />

                            <com.google.android.material.tabs.TabLayout
                                android:id="@+id/tabPanelTasks"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:tabMode="fixed" />

                            <TextView
                                android:id="@+id/textPanelTaskEmpty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="32dp"
                                android:gravity="center"
                                android:text="暂无任务"
                                android:textSize="14sp"
                                android:textColor="@color/color_text_secondary"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/textPanelTaskError"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="32dp"
                                android:gravity="center"
                                android:text="加载失败，点击重试"
                                android:textSize="15sp"
                                android:textColor="@color/color_error"
                                android:contentDescription="点击重试"
                                android:visibility="gone" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerPanelTaskTable"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false" />

                        </LinearLayout>

                    </androidx.core.widget.NestedScrollView>

                </com.example.project_pandora.ui.widget.MonthCalendarLayout>

                <FrameLayout
                    android:id="@+id/containerWeekView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <com.example.project_pandora.ui.widget.TaskScheduleView
                        android:id="@+id/weekSchedule"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:scheduleMode="week" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/containerDayView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <com.example.project_pandora.ui.widget.TaskScheduleView
                        android:id="@+id/daySchedule"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:scheduleMode="day" />

                </FrameLayout>

            </FrameLayout>

        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddTask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:contentDescription="添加任务"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="@color/color_accent"
            app:tint="@color/color_on_accent"
            android:layout_gravity="bottom|end" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
