<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_bg_page">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        app:title="梅花易数"
        app:titleTextColor="@color/color_text_primary"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        style="@style/Widget.Pandora.Toolbar"
        app:navigationIconTint="@color/color_text_primary"
        android:elevation="0dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 娱乐提示 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="仅供娱乐与文化体验，请理性看待"
                android:textSize="12sp"
                android:textColor="@color/color_text_secondary"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDivine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="随机起卦"
                android:textSize="16sp"
                android:backgroundTint="@color/color_accent"
                android:layout_marginBottom="24dp"
                android:textColor="@color/color_on_accent" />

            <!-- 结果展示区 -->
            <TextView
                android:id="@+id/textResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- 本卦 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardOriginal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:cardBackgroundColor="@color/color_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本卦"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_accent" />

                    <!-- Round27 REQ-27-13: 本卦卦象（自绘爻型，动爻高亮） -->
                    <com.example.project_pandora.ui.ai.HexagramView
                        android:id="@+id/hexagramOriginal"
                        android:layout_width="120dp"
                        android:layout_height="84dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textOriginalName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/textOriginalJudgment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/color_text_primary"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 互卦 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMutual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:cardBackgroundColor="@color/color_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="互卦"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_accent" />

                    <!-- Round27 REQ-27-13: 互卦卦象（自绘爻型，无动爻高亮） -->
                    <com.example.project_pandora.ui.ai.HexagramView
                        android:id="@+id/hexagramMutual"
                        android:layout_width="120dp"
                        android:layout_height="84dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textMutualName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/textMutualJudgment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/color_text_primary"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 变卦 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardChanged"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:cardBackgroundColor="@color/color_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="变卦"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_accent" />

                    <!-- Round27 REQ-27-13: 变卦卦象（自绘爻型，无动爻高亮） -->
                    <com.example.project_pandora.ui.ai.HexagramView
                        android:id="@+id/hexagramChanged"
                        android:layout_width="120dp"
                        android:layout_height="84dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textChangedName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/textChangedJudgment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/color_text_primary"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 动爻信息 -->
            <TextView
                android:id="@+id/textMovingLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:visibility="gone"
                android:layout_marginTop="8dp" />

            <!-- AI 解读卡片 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAiAnalysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:cardBackgroundColor="@color/color_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI 解读"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_accent" />

                    <TextView
                        android:id="@+id/textAiAnalysis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/color_text_primary"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/textAiSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/color_text_secondary"
                        android:layout_marginTop="4dp"
                        android:gravity="end" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>