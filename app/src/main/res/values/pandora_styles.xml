<resources>
    <style name="TextAppearance.Pandora.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>
    <style name="TextAppearance.Pandora.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>
    <style name="TextAppearance.Pandora.BodySmall" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>
    <style name="TextAppearance.Pandora.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.Pandora.Navigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.Pandora.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/color_surface</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.Pandora.Title</item>
        <item name="titleTextColor">@color/color_text_primary</item>
        <item name="subtitleTextColor">@color/color_text_secondary</item>
        <item name="navigationIconTint">@color/color_text_primary</item>
        <item name="contentInsetStart">20dp</item>
        <item name="contentInsetEnd">16dp</item>
    </style>
    <style name="Widget.Pandora.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Pandora.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.Pandora.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/color_border_strong</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Pandora.Label</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Pandora.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Pandora.Label</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Pandora.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/color_divider</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.Pandora.LegacyCard" parent="CardView">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">1dp</item>
    </style>
    <style name="Widget.Pandora.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/color_surface</item>
        <item name="boxStrokeColor">@color/pandora_input_stroke</item>
        <item name="hintTextColor">@color/color_accent</item>
        <item name="android:textColorHint">@color/color_text_secondary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>
    <style name="Widget.Pandora.Tabs" parent="Widget.Material3.TabLayout">
        <item name="android:background">@color/color_surface</item>
        <item name="tabTextAppearance">@style/TextAppearance.Pandora.Label</item>
        <item name="tabTextColor">@color/color_text_secondary</item>
        <item name="tabSelectedTextColor">@color/color_accent</item>
        <item name="tabIndicatorColor">@color/color_accent</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabRippleColor">@color/color_accent_soft</item>
    </style>
    <style name="Widget.Pandora.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/pandora_chip_background</item>
        <item name="android:textColor">@color/pandora_chip_text</item>
        <item name="chipStrokeColor">@color/color_divider</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>
    <style name="Widget.Pandora.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/color_surface</item>
        <item name="elevation">0dp</item>
        <item name="itemIconSize">23dp</item>
        <item name="itemIconTint">@color/bottom_nav_color_selector</item>
        <item name="itemTextColor">@color/bottom_nav_color_selector</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Pandora.Navigation</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Pandora.Navigation</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Pandora.NavIndicator</item>
    </style>
    <style name="Widget.Pandora.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/color_accent_soft</item>
    </style>
    <style name="Widget.Pandora.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/color_accent</item>
        <item name="tint">@color/color_on_accent</item>
        <item name="elevation">2dp</item>
    </style>
</resources>
