<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Project_Pandora"
        android:screenOrientation="portrait"
        android:usesCleartextTraffic="true"
        android:name=".PandoraApplication"
        tools:targetApi="31">
        <service
            android:name=".notification.PollingForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity android:name=".ui.task.TaskReviewsActivity" android:exported="false" />
        <activity android:name=".ui.task.TaskTagManageActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.task.TaskDetailsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.home.HomeBoardsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.view.CompanyDirectoryActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.view.CompanyPersonActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.view.CompanyPersonTasksActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.view.CompanyPersonLogsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.task.TaskFilterPeopleActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.task.TaskAssigneesActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Project_Pandora"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity

            android:name=".ui.task.TaskCreateActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.task.TaskDetailActivity"

            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.log.LogCreateActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.log.LogDetailActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".ui.log.LogPeoplePickerActivity" android:exported="false"
            android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.ai.MBTITestActivity"
            android:screenOrientation="portrait" />
        <activity

            android:name=".ui.ai.KeywordAnalysisActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.ai.SuggestionActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.ai.AiConfigActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mine.ServerConfigActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mine.ProfileActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mine.HierarchyManageActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.focus.FocusActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.login.ForgotPasswordActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mine.ResetRequestsActivity"
            android:screenOrientation="portrait" />
        <activity

            android:name=".ui.aimap.DataCollectActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.aimap.AIAnalysisActivity"
            android:screenOrientation="portrait" />
        <activity

            android:name=".ui.mine.SettingsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mine.UserRelationActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.aimap.BirthFortuneActivity"
            android:exported="false" />
        <activity
            android:name=".ui.aimap.DivinationActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.log.Top10WorkEditActivity"
            android:screenOrientation="portrait" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
